{
    // Clangd 配置
    "clangd.arguments": [
        "--compile-commands-dir=/home/hooloofrog/ToyNet/code/linux/linux_primer/build-ninja",
        "--background-index",
        "--clang-tidy",
        "--cache-dir=/home/hooloofrog/ToyNet/code/linux/linux_primer/build-ninja/.clangd-cache"
    ],

    // C 格式化器
    "[c]": {
        "editor.defaultFormatter": "xaver.clang-format"
    },

    // 终端字体
    "terminal.integrated.fontFamily": "Hack Nerd Font Mono",

    // ---------------------------
    // CMake Tools 配置
    // ---------------------------
    "cmake.buildDirectory": "${workspaceFolder}/build-ninja",  // 指定 Ninja 构建目录
    "cmake.generator": "Ninja",                               // 使用 Ninja 生成
    "cmake.configureOnOpen": false                             // 打开工作区不自动生成默认 build
}


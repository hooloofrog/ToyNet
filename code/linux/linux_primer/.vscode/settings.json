{
    // ================= 1. C/C++ 核心 (Clangd 模式) =================
    // 禁用微软cpptools的IntelliSense相关能力，保留【图形调试gdb面板】
    "C_Cpp.intelliSenseEngine": "disabled",
    "C_Cpp.formatting": "disabled",
    "C_Cpp.autocomplete": "disabled",
    "C_Cpp.errorSquiggles": "disabled",
    "C_Cpp.hover": "disabled", // 新增：避免cpptools悬浮提示和clangd冲突

    // ================= 2. Clangd 配置 =================
    "clangd.path": "/usr/bin/clangd",
    "clangd.arguments": [
        "--background-index",                // 后台索引，跳转更快
        "--clang-tidy",                      // 开启clang-tidy静态检查
        "--completion-style=detailed",       // 详细补全信息
        "--function-arg-placeholders",       // 函数参数占位提示
        "--header-insertion=iwyu",           // IWYU自动头文件管理，不喜欢就改成 never
        "--all-scopes-completion",           // 新增：补全包含私有、内部作用域符号
        "--query-driver=/usr/bin/gcc,/usr/bin/g++" // 修正：只指定gcc/g++，不再用*通配
    ],

    // ================= 3. 格式化配置 =================
    "clang-format.executable": "/usr/bin/clang-format",
    "[c]": {
        "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd",//xaver.clang-format
        "editor.formatOnSave": false,
        "editor.formatOnPaste": false
    },
    "[cpp]": {
        "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd",
        "editor.formatOnSave": false,
        "editor.formatOnPaste": false
    },

    // ================= 4. CMake 配置 (无链接模式) =================
    "cmake.buildDirectory": "${workspaceFolder}/build-ninja",
    "cmake.generator": "Ninja",
    "cmake.configureOnOpen": true,
    // 【优化】删除 copyCompileCommands，不再生成根目录软链接
    // Clangd 会自动在 build-ninja 中查找 compile_commands.json

    // ================= 5. 编辑器体验优化 =================
    // 括号匹配高亮（C++ 必备，防止眼花）
    "editor.guides.bracketPairs": "active",
    // 自动闭合括号
    "editor.autoClosingBrackets": "always",

    // ================= 6. 终端与字体 =================
    "terminal.integrated.fontFamily": "'Maple Mono NF CN', 'Maple Mono NF CN Light', Consolas, monospace",
    "terminal.integrated.fontSize": 17.5,
    "terminal.integrated.lineHeight": 1.22,
    "terminal.integrated.letterSpacing": 0.05,
    "terminal.integrated.fontWeight": "400",
    "terminal.integrated.smoothScrolling": true,
    "terminal.integrated.gpuAcceleration": "on",

    "editor.fontFamily": "'ComicShannsMono Nerd Font', 'Maple Mono NF CN', 'Maple Mono NF CN Light', 'Microsoft YaHei', Consolas, monospace",
    "editor.fontSize": 18,
    "editor.lineHeight": 26,
    "editor.letterSpacing": 0.15,
    "editor.fontWeight": "normal",
    "editor.fontLigatures": false,

    //"editor.lineNumbersFontSize": 17,
    "editor.suggestFontSize": 16,
    //"editor.hover.fontSize": 16,
    //"breadcrumbs.fontSize": 16,
    "scm.inputFontSize": 16,

    "window.zoomLevel": 0,
    "cSpell.words": [
        "ggdb",
        "STREQUAL",
        "clangd",
        "compile_commands",
        "hooloofrog",
        "ToyNet",
        "iwyu"
    ],

    // ================= 7. 性能与搜索优化 (关键) =================
    // 【优化】排除构建目录，防止全局搜索时卡死
    "search.exclude": {
        "**/build-ninja": true,
        "**/build": true,
        "**/bin": true,
        "**/obj": true
    },
    // 文件资源管理器中也隐藏构建目录，保持清爽
    "files.exclude": {
        "**/build-ninja": true,
        "**/build": true
    },

    // ================= 8. 内置 Git Blame =================
    "git.blame.statusBarItem.enabled": true,
    //"git.blame.statusBarItem.format": "${author} • ${date} • ${shortHash}",
    "git.blame.statusBarItem.format": "${shortHash} ${author}",
    "git.blame.statusBarItem.dateFormat": "yyyy-MM-dd",
    "git.blame.inline.enabled": false,
    "git.blame.inline.format": "${author}, ${date}",
    "git.blame.inline.dateFormat": "yyyy-MM-dd",

    // ================= 9. 其他 =================
    "json.schemaDownload.enable": true
}

{
    // Clangd 配置
    "clangd.arguments": [
        "--compile-commands-dir=/home/hooloofrog/ToyNet/code/cpp/accelerated_cpp/build-ninja",
        "--background-index",
        "--clang-tidy"
    ],

    // C++ 格式化器
    "[cpp]": {
        "editor.defaultFormatter": "xaver.clang-format"
    },

    // ================= 6. 终端与字体 =================
    "terminal.integrated.fontFamily": "'Maple Mono NF CN', 'Maple Mono NF CN Light', Consolas, monospace",
    "terminal.integrated.fontSize": 17.5,
    "terminal.integrated.lineHeight": 1.22,
    "terminal.integrated.letterSpacing": 0.05,
    "terminal.integrated.fontWeight": "400",
    "terminal.integrated.smoothScrolling": true,
    "terminal.integrated.gpuAcceleration": "on",

    "editor.fontFamily": "'ComicShannsMono Nerd Font', 'Maple Mono NF CN', 'Maple Mono NF CN Light', 'Microsoft YaHei', Consolas, monospace",
    "editor.fontSize": 18,
    "editor.lineHeight": 26,
    "editor.letterSpacing": 0.15,
    "editor.fontWeight": "normal",
    "editor.fontLigatures": false,

    "editor.lineNumbersFontSize": 17,
    "editor.suggestFontSize": 16,
    "editor.hover.fontSize": 16,
    "breadcrumbs.fontSize": 16,
    "scm.inputFontSize": 16,

    "window.zoomLevel": 0,
    "cSpell.words": [
        "ggdb",
        "STREQUAL",
        "clangd",
        "compile_commands",
        "hooloofrog",
        "ToyNet",
        "iwyu"
    ],

    // ---------------------------
    // CMake Tools 配置
    // ---------------------------
    "cmake.buildDirectory": "${workspaceFolder}/build-ninja",  // 指定 Ninja 构建目录
    "cmake.generator": "Ninja",                               // 使用 Ninja 生成
    "cmake.configureOnOpen": false                             // 打开工作区不自动生成默认 build
}

